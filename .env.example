# Supabase/PostgreSQL (produção)
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres
DATABASE_SSL=false
DATABASE_POOL_MAX=5
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key

# Opcional: provedor rodoviário real. Sem esta chave o app mostra estimativas por coordenadas.
GOOGLE_MAPS_API_KEY=
ROUTES_PROVIDER=
ROUTES_API_KEY=

# Geocodificação e mapa sem segredo no frontend. O padrão usa Nominatim + OpenStreetMap.
GEOCODING_PROVIDER=nominatim
NEXT_PUBLIC_GEOCODING_PROVIDER=nominatim
NEXT_PUBLIC_MAP_PROVIDER=openstreetmap

# URL pública usada para links de compartilhamento e callbacks futuros.
NEXT_PUBLIC_APP_URL=http://localhost:5173
# Em Sites, a aplicação usa por padrão o serviço Render público como API.
NEXT_PUBLIC_DATA_API_URL=
